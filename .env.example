# @BotFather dan olingan token
BOT_TOKEN=123456:ABC...

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Hisobot tugmalaridan foydalana oladigan belgilangan adminlar ID lari (vergul bilan).
# ID ni bilish: botga /start yozing — ruxsat bo'lmasa ham ID ingizni ko'rsatadi
SUPER_ADMINS=

# Avtomatik hisobotlar yuboriladigan chat ID (masalan, rahbariyat guruhi). Bo'sh bo'lsa — SUPER_ADMINS ga yuboriladi
REPORT_CHAT_ID=

# Avtomatik hisobot vaqti: har kuni kechagi, dushanba kuni o'tgan hafta, oyning 1-kuni o'tgan oy hisoboti
REPORT_TIME=09:00

# all  — oddiy a'zoning har bir xabari savol hisoblanadi
# mark — faqat "?" belgisi bor xabarlar savol hisoblanadi
QUESTION_MODE=all

# Faqat shu guruhlarni kuzatish (vergul bilan). Bo'sh — barcha guruhlar
ALLOWED_CHATS=

DB_PATH=data.db
